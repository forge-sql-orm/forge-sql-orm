{
  "name": "jira-global-page-custom-ui",
  "version": "1.1.4",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@forge/api": "^8.5.1",
    "@forge/events": "^3.0.11",
    "@forge/kvs": "^2.1.3",
    "@forge/resolver": "2.0.2",
    "@forge/sql": "^4.0.11",
    "drizzle-orm": "^0.45.4",
    "forge-sql-orm": "^2.2.7",
    "forge-sql-orm-extra": "2.2.7"
  },
  "scripts": {
    "models:create": "forge-sql-orm-cli generate:model --output src/entities",
    "migration:create": "forge-sql-orm-cli migrations:create --force",
    "migration:update": "forge-sql-orm-cli migrations:update",
    "migration:drop": "forge-sql-orm-cli migrations:drop",
    "build:ci": "tsc --target esnext --project tsconfig.json --ignoreDeprecations 6.0 --outDir dist && rm -rf dist",
    "forge:debug": "forge tunnel -d -f index.handler",
    "build:husky": "tsc --project tsconfig.json  --outDir ./dist && rm -rf ./dist",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "forge-sql-orm-cli": "^2.2.7",
    "knip": "^6.48.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "glob": "npm:glob@latest",
    "prosemirror-view": "npm:prosemirror-view@latest",
    "package-json": "npm:package-json@latest",
    "esbuild": "npm:esbuild@latest",
    "parse-url": "npm:parsed-url@latest",
    "gry": "npm:gry@latest",
    "minimatch": "npm:minimatch@latest"
  }
}
